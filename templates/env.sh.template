# Daisy Environment Variables Template
# Copy this file to your workspace root as .env.sh
# Then fill in your values

# Core Daisy paths (required)
export DAISY_ROOT="/path/to/daisy"
# No home variable: the home is resolved from the workspace's .daisy/home
# through the registry (~/.config/daisy/homes).

# API tokens (optional, per integration)
export DAISY_SECRET_WEBEX_API_TOKEN=""
export DAISY_SECRET_BACKSTAGE_TOKEN=""
export DAISY_SECRET_JIRA_API_TOKEN=""
export DAISY_SECRET_GITHUB_TOKEN=""
